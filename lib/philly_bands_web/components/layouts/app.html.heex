<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
    <footer class="mt-auto pt-10 text-center text-sm text-zinc-500">
      <p>
        This data comes from
        <a href="https://xpn.org/concert-and-events/" class="underline hover:text-zinc-700">
          WXPN's concert calendar
        </a>
      </p>
    </footer>
  </div>
</main>
